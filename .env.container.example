# Settings for the qbittorrent-mcp container (Container Manager). Copy to .env in the project folder
# on the NAS, next to docker-compose.yml. See docs/mcp-server.md, "Running in Container Manager".
# docker-compose.yml sets QBT_MCP_TRANSPORT, QBT_MCP_HOST and QBT_MCP_PORT; don't set them here.
# Quote values containing $, # or spaces with single quotes.

# --- qBittorrent ---
# The NAS's LAN IP. Not "localhost": inside the container, localhost is the container itself.
QBT_HOST=192.168.1.50
# The WebUI port gluetun publishes (WEBUI_PORT in the qbittorrent compose project).
QBT_PORT=8090
# The same API key as in your local .env (WebUI → Options → Web UI → API Key).
QBT_API_KEY=qbt_change-me

# --- What the MCP server may do ---
QBT_SANDBOX_TAG=poc
QBT_SANDBOX_SAVEPATH=/data/torrents/poc
QBT_MCP_ALLOW_WRITES=false
QBT_MCP_ALLOW_DELETE=false

# --- HTTP access ---
# Clients send it as "Authorization: Bearer <token>". At least 32 characters: openssl rand -hex 32
QBT_MCP_TOKEN=
