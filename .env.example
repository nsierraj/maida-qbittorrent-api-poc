# qBittorrent WebUI on the NAS: the NAS LAN IP (not "localhost": from inside a container,
# localhost is the container itself) and the port gluetun publishes for the WebUI (WEBUI_PORT).
QBT_HOST=192.168.1.50
QBT_PORT=8090

# API key (qBittorrent >= 5.2): WebUI -> Tools -> Options -> Web UI -> API Key -> Generate.
# Sent as "Authorization: Bearer qbt_...". No username/password needed.
QBT_API_KEY=qbt_change-me

# Sandbox: write operations (examples and MCP write tools) only touch torrents carrying this tag.
QBT_SANDBOX_TAG=poc
# Save path for test torrents added by the examples. A path INSIDE the qbittorrent container,
# e.g. /data/torrents/poc is /volume1/data/torrents/poc on the NAS.
QBT_SANDBOX_SAVEPATH=/data/torrents/poc

# Optional: where examples write local output (sanitized samples). Gitignored. Default: out
QBT_POC_OUT=

# Optional: the torrent examples/03_lifecycle.py adds, starts briefly and deletes. Must be legal
# to download. Default: the Lubuntu 26.04 desktop ISO.
QBT_TEST_MAGNET=
